###################
# LLM
###################

# "custom" = any OpenAI-compatible endpoint (llama.cpp, vLLM, Ollama, LM Studio...).
# Other Hermes providers (e.g. openrouter) read their key from their own
# variable (e.g. OPENROUTER_API_KEY): add it to this file.
LLM_PROVIDER=custom

# OpenAI-compatible endpoint as seen from inside the container (required for "custom").
# host.docker.internal is the Docker host: with Docker Desktop, the Windows host.
LLM_BASE_URL=http://host.docker.internal:8080/v1

# Model id exactly as the endpoint lists it (GET <LLM_BASE_URL>/models).
LLM_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL

# Key for the "custom" endpoint. Leave empty if the server runs without --api-key.
LLM_API_KEY=

###################
# Telegram
###################

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric user IDs allowed to use the bot (ask @userinfobot).
TELEGRAM_ALLOWED_USERS=

###################
# Container
###################

TZ=Europe/Rome

# Owner of services/hermes/data on the host (`id -u` / `id -g`).
HERMES_UID=1000
HERMES_GID=1000

# Image tag. Pin a release instead of latest for reproducible updates.
#HERMES_VERSION=latest
