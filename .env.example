###################
# LLM
###################

# "custom" = any OpenAI-compatible endpoint (llama.cpp, vLLM, Ollama, LM Studio...).
# Other Hermes providers (e.g. openrouter) read their key from their own
# variable (e.g. OPENROUTER_API_KEY): add it to this file.
LLM_PROVIDER=custom

# OpenAI-compatible endpoint as seen from inside the container. Required for
# "custom": if empty, Hermes silently falls back to OpenRouter's URL and the
# first request fails with an auth error. Leave empty for native providers.
# host.docker.internal is the Docker host: with Docker Desktop, the Windows host.
LLM_BASE_URL=http://host.docker.internal:8080/v1

# Model id exactly as the endpoint lists it (GET <LLM_BASE_URL>/models).
LLM_MODEL=gemma-4-12B-it-qat-UD-Q4_K_XL

# Key for the "custom" endpoint. Leave empty if the server runs without --api-key.
LLM_API_KEY=

###################
# Telegram
###################

# Optional: leave both empty to run without Telegram (the gateway stays up
# with no messaging platform). Set both to enable the bot.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric user IDs allowed to use the bot (ask @userinfobot).
TELEGRAM_ALLOWED_USERS=

###################
# Discord
###################

# Optional: leave both empty to run without Discord. Set both to enable the bot.
# With a token but no allowlist the bot connects and denies every user.
# In the Developer Portal (Bot tab) turn on the "Message Content Intent",
# otherwise Discord refuses the connection; "Server Members Intent" is also
# needed to allow users by username.

# Bot token from https://discord.com/developers/applications.
DISCORD_BOT_TOKEN=

# Comma-separated numeric user IDs allowed to use the bot (Developer Mode ->
# right click your profile -> Copy User ID).
DISCORD_ALLOWED_USERS=

# Further options, all optional. Keep them commented out to get the default
# (shown): a blank value is not the same as an unset one.

# Comma-separated role IDs whose members are allowed too (OR with the users).
# Needs the "Server Members Intent".
#DISCORD_ALLOWED_ROLES=

# Comma-separated channel IDs: the bot answers only there / never answers there.
#DISCORD_ALLOWED_CHANNELS=
#DISCORD_IGNORED_CHANNELS=

# Channel ID for proactive messages (cron output, notifications).
#DISCORD_HOME_CHANNEL=

# Require an @mention in server channels (DMs never need one).
#DISCORD_REQUIRE_MENTION=true

# Comma-separated channel IDs where no @mention is needed.
#DISCORD_FREE_RESPONSE_CHANNELS=

# Open a thread for each @mention in a text channel.
#DISCORD_AUTO_THREAD=true

###################
# Container
###################

TZ=Europe/Rome

# Owner of services/hermes/data on the host (`id -u` / `id -g`).
HERMES_UID=1000
HERMES_GID=1000

# Image tag. Pin a release instead of latest for reproducible updates.
#HERMES_VERSION=latest
